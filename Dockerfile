# ---- Build stage ----
FROM node:20-slim AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_ARC_SOURCES_READ_TOKEN
ARG PUBLIC_USER_POOL_ID
ARG PUBLIC_USER_POOL_CLIENT_ID
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_ARC_SOURCES_READ_TOKEN=$VITE_ARC_SOURCES_READ_TOKEN
ENV PUBLIC_USER_POOL_ID=$PUBLIC_USER_POOL_ID
ENV PUBLIC_USER_POOL_CLIENT_ID=$PUBLIC_USER_POOL_CLIENT_ID

RUN npm run build

# ---- Run stage ----
FROM node:20-slim AS run
WORKDIR /app

COPY --from=build /app/build build
COPY --from=build /app/package*.json ./
RUN npm ci --omit=dev

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["node", "build"]