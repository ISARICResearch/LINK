# ---- Build stage ----
FROM node:20-slim AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG PUBLIC_SUPABASE_URL
ARG PUBLIC_SUPABASE_ANON_KEY
ARG PUBLIC_ARC_SOURCES_READ_TOKEN
ARG PUBLIC_USER_POOL_ID
ARG PUBLIC_USER_POOL_CLIENT_ID
ENV PUBLIC_SUPABASE_URL=$PUBLIC_SUPABASE_URL
ENV PUBLIC_SUPABASE_ANON_KEY=$PUBLIC_SUPABASE_ANON_KEY
ENV PUBLIC_ARC_SOURCES_READ_TOKEN=$PUBLIC_ARC_SOURCES_READ_TOKEN
ENV PUBLIC_USER_POOL_ID=$PUBLIC_USER_POOL_ID
ENV PUBLIC_USER_POOL_CLIENT_ID=$PUBLIC_USER_POOL_CLIENT_ID

RUN npm run build

# ---- Run stage ----
FROM node:20-slim AS run
WORKDIR /app

COPY --from=build /app/build build
COPY --from=build /app/package*.json ./
RUN npm ci --omit=dev

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["node", "build"]